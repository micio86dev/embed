{
  "name": "@beai/embed",
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "private": false,
  "description": "BEAI embed SDK — zero-dependency TypeScript client for embedding BEAI interviews via iframe + postMessage.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/embed.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "size": "node scripts/check-bundle-size.mjs",
    "prepare": "husky"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.52",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^3.0",
    "eslint": "^9.0",
    "husky": "^9.1",
    "jsdom": "^30.1.1",
    "lint-staged": "^15.0",
    "prettier": "^3.5",
    "tsup": "^8.3",
    "typescript": "^5.8",
    "typescript-eslint": "^8.0",
    "vitest": "^3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
